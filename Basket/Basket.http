Content-Type: application/json
//Authorization: Bearer {{accessToken}}
{
    "UserName": "swn",
    "Items": [
        {
        "Quantity": 2,
        "Color": "Red",
        "Price": 0,
        "ProductId": 1,
        "ProductName": "Laptop"
        }
        
    ]
}

